# =====================================
# Unity 通用忽略规则
# =====================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Pp]references/
/[Uu]ser[Ss]ettings/
/[Pp]ackages-lock.json
/Packages/*.json.meta
/Packages~

# Mono 崩溃日志
mono_crash.*.json

# 特定于 Unity 的文件和目录
*.pidb
*.unityproj
*.booproj
*.sln
*.csproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb.meta
*.pdb
*.mdb
*.lastbuildstate
*.apk
*.aab
*.ipa
*.xcode

# =====================================
# HybridCLR 相关忽略规则
# =====================================
# HybridCLR 生成的热更新文件
/Assets/HotUpdateResources/
/Assets/Plugins/HybridCLR/Generated/
/Assets/Plugins/HybridCLR/Editor/ILPostProcessors/Generated/
/Assets/Plugins/HybridCLR/Editor/ILPostProcessors/Intermediate/
/Assets/Plugins/HybridCLR/Editor/ILPostProcessors/Temp/
/Assets/Plugins/HybridCLR/Editor/ILPostProcessors/Log/

# HybridCLR 运行时数据
/hybridclr_assets/
/hybridclr_il2cpp_output/
/hybridclr_il2cpp_output_*/
/HybridCLRData/HotUpdateDlls
/HybridCLRData/AssembliesPostIl2CppStrip
# HybridCLR Installer 在本机生成的 il2cpp 环境（约 800MB，新机器重新 Install 即可）
/HybridCLRData/LocalIl2CppData-*/
# 服务器输出目录（打包产物，不入版本库）
/HybridCLRData/ServerOutput/

# 预编译的 dll
/Assets/Plugins/HybridCLR/AOT/
/Assets/Plugins/HybridCLR/HotUpdateDlls/

# StreamingAssets 下打包拷贝的 AOT 元数据、热更 DLL 与内置注册表（由打包脚本生成）
/Assets/StreamingAssets/AOT/
/Assets/StreamingAssets/AOT.meta
# 通配所有热更 DLL（多游戏模式下每个子游戏各有自己的 DLL）
/Assets/StreamingAssets/*.dll
/Assets/StreamingAssets/*.dll.meta
/Assets/StreamingAssets/games.json
/Assets/StreamingAssets/games.json.meta

# =====================================
# 常见第三方插件忽略规则
# =====================================
# Addressables 构建产物（配置文件 AssetGroups/*.asset 入版本库，构建产物不入库）
/Assets/AddressableAssetsData/ContentState/
/Assets/AddressableAssetsData/builds/
# 2.x 起内容更新状态文件写入按平台命名的子目录，属构建产物
/Assets/AddressableAssetsData/*/addressables_content_state.bin*
/Assets/AddressableAssetsData/AssetBundleManifest.asset
# 远程构建输出目录（ServerData，由打包脚本生成）
/ServerData/

# TextMeshPro
/TMP/Fonts/*
!/TMP/Fonts/*.meta

# 其他常见插件
/Plugins/Android/
/Plugins/iOS/
/GoogleMobileAds/
/Firebase/
/ProBuilder/

# =====================================
# 系统文件和编辑器配置
# =====================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/
*.sln.DotSettings.user
*.sln.DotSettings

# Windows 系统文件
Desktop.ini

# =====================================
# 自定义保留文件
# =====================================
# 如果需要保留某些文件，请取消注释并添加路径
# !Assets/YourCustomFile.txt
# Python 缓存
__pycache__/
*.pyc

# HybridCLR v9 构建临时目录
/HybridCLRData/StrippedAOTDllsTempProj/
# Addressables 出包时自动生成的裁剪声明（每次构建重新生成）
/Assets/AddressableAssetsData/link.xml
/Assets/AddressableAssetsData/link.xml.meta
